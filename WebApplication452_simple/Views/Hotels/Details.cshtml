@model WebApplication452_simple.Models.Hotel

@{
    ViewData["Title"] = "Hotel Details";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Country</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Country.Name)</dd>

            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-4">City</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.City)</dd>

            <dt class="col-sm-4">Stars</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Stars)</dd>

            <dt class="col-sm-4">Price Per Night</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PricePerNight)</dd>

            <dt class="col-sm-4">All Inclusive</dt>
            <dd class="col-sm-8">
                @if (Model.IsAllInclusive)
                {
                    <span class="badge badge-success">Yes</span>
                }
                else
                {
                    <span class="badge badge-secondary">No</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>