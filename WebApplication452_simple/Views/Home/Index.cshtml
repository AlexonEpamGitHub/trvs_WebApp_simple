@{
    ViewData["Title"] = "Home Page";
}

<main role="main">
    <div class="container">
        <section class="row mb-5" aria-labelledby="aspnetTitle">
            <div class="col-12">
                <h1 id="aspnetTitle" class="display-4">ASP.NET</h1>
                <p class="lead">ASP.NET is a free web framework for building great websites and web applications using HTML, CSS, and JavaScript.</p>
                <p><a href="https://asp.net" class="btn btn-primary btn-lg" aria-label="Learn more about ASP.NET">Learn more &raquo;</a></p>
            </div>
        </section>

        <div class="row">
            <section class="col-md-4 mb-4" aria-labelledby="gettingStartedTitle">
                <h2 id="gettingStartedTitle" class="h4">Getting Started</h2>
                <p>
                    ASP.NET MVC provides a powerful, patterns-based approach to building dynamic websites. It enables a clean separation of concerns and offers full control over markup for enjoyable, agile development.
                </p>
                <p><a class="btn btn-outline-primary" href="https://go.microsoft.com/fwlink/?LinkId=301865" aria-label="Learn more about getting started with ASP.NET MVC">Learn more &raquo;</a></p>
            </section>
            <section class="col-md-4 mb-4" aria-labelledby="librariesTitle">
                <h2 id="librariesTitle" class="h4">Get More Libraries</h2>
                <p>
                    NuGet is a free Visual Studio extension that simplifies adding, removing, and updating libraries and tools in Visual Studio projects.
                </p>
                <p><a class="btn btn-outline-primary" href="https://go.microsoft.com/fwlink/?LinkId=301866" aria-label="Learn more about NuGet libraries">Learn more &raquo;</a></p>
            </section>
            <section class="col-md-4 mb-4" aria-labelledby="hostingTitle">
                <h2 id="hostingTitle" class="h4">Web Hosting</h2>
                <p>
                    You can easily find a web hosting company that offers the right mix of features and pricing for your applications.
                </p>
                <p><a class="btn btn-outline-primary" href="https://go.microsoft.com/fwlink/?LinkId=301867" aria-label="Learn more about web hosting for ASP.NET applications">Learn more &raquo;</a></p>
            </section>
        </div>
    </div>
</main>