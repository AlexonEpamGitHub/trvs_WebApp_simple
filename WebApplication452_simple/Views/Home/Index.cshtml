@model YourProject.Models.HotelViewModel
@{
    ViewBag.Title = "Home Page";
}

<main class="container mt-5">
    <section class="text-center mb-5">
        <h1 id="title">Welcome to Our Hotel Finder</h1>
        <p class="lead">Find the best hotels tailored to your needs. Enjoy modern comfort and convenience.</p>
    </section>

    <section class="mb-4">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="SearchQuery" class="form-control" placeholder="Search hotels..." value="@Model.SearchQuery" />
            </div>
            <div class="col-md-3">
                <select name="Filter" class="form-select">
                    <option value="">-- Filter by --</option>
                    <option value="PriceLowToHigh" @(Model.CurrentFilter == "PriceLowToHigh" ? "selected" : "")>Price: Low to High</option>
                    <option value="PriceHighToLow" @(Model.CurrentFilter == "PriceHighToLow" ? "selected" : "")>Price: High to Low</option>
                    <option value="RatingHighToLow" @(Model.CurrentFilter == "RatingHighToLow" ? "selected" : "")>Rating: High to Low</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </form>
    </section>

    <section>
        @if (Model.Hotels != null && Model.Hotels.Any())
        {
            <div class="row">
                @foreach (var hotel in Model.Hotels)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <img src="@hotel.ImageUrl" class="card-img-top" alt="@hotel.Name" />
                            <div class="card-body">
                                <h5 class="card-title">@hotel.Name</h5>
                                <p class="card-text">@hotel.Description</p>
                                <p class="card-text"><strong>Price:</strong> $@hotel.Price / night</p>
                                <p class="card-text"><strong>Rating:</strong> @hotel.Rating / 5</p>
                                <a asp-action="Details" asp-route-id="@hotel.Id" class="btn btn-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No hotels found. Please adjust your search or filter criteria.</p>
        }
    </section>

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchQuery="@Model.SearchQuery" asp-route-filter="@Model.CurrentFilter">@i</a>
                </li>
            }
        </ul>
    </nav>
</main>