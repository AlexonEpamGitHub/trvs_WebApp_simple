@{
    ViewData["Title"] = "About";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewData["Title"]</h2>
    <h3>@Model.Message</h3>

    <div class="card mt-4">
        <div class="card-body">
            <p class="lead">Use this area to provide additional information.</p>
            <p>This view uses tag helpers and modern Bootstrap styling.</p>
            <environment include="Development">
                <p class="text-info">This message only appears in development environment.</p>
            </environment>
        </div>
    </div>
</main>