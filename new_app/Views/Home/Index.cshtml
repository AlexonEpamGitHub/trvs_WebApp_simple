@using Microsoft.AspNetCore.Hosting
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Home Page";
}

<main role="main" class="pb-3">
    <div class="text-center">
        <h1 class="display-4">Welcome to the Migration App</h1>
        <p>Explore the capabilities and features of .NET 8 and ASP.NET Core</p>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <h2 id="getting-started">Getting Started</h2>
                <p>Learn how to build your first ASP.NET Core application.</p>
                <a class="btn btn-primary" href="https://learn.microsoft.com/aspnet/core/getting-started" target="_blank">Learn More</a>
            </div>

            <div class="col-md-4">
                <h2 id="libraries">Libraries</h2>
                <p>Discover the powerful libraries available in .NET 8.</p>
                <a class="btn btn-primary" href="https://learn.microsoft.com/dotnet/libraries" target="_blank">Learn More</a>
            </div>

            <div class="col-md-4">
                <h2 id="hosting">Hosting</h2>
                <p>Understand the hosting options for ASP.NET Core apps.</p>
                <a class="btn btn-primary" href="https://learn.microsoft.com/aspnet/core/host-and-deploy" target="_blank">Learn More</a>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
}