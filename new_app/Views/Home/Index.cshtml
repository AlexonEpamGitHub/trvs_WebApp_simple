@{
    ViewData["Title"] = "Home Page";
}

<main class="container">
    <section class="row justify-content-center my-5" aria-labelledby="aspnetTitle">
        <div class="col-md-10 text-center">
            <h1 id="title" class="display-4">ASP.NET Core</h1>
            <p class="lead">ASP.NET Core is a cross-platform, high-performance, open-source framework for building modern, cloud-enabled, internet-connected applications.</p>
            <p><a href="https://docs.microsoft.com/aspnet/core" class="btn btn-primary btn-lg">Learn more &raquo;</a></p>
        </div>
    </section>

    <div class="row g-4 my-4">
        <section class="col-md-4" aria-labelledby="gettingStartedTitle">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 id="gettingStartedTitle" class="card-title h4">Getting started</h2>
                    <p class="card-text">
                        ASP.NET Core MVC provides features to build web APIs and web apps:
                        The Model-View-Controller pattern helps make your web APIs and web apps testable.
                    </p>
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="Home" asp-action="Privacy">Learn more &raquo;</a>
                </div>
            </div>
        </section>
        <section class="col-md-4" aria-labelledby="librariesTitle">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 id="librariesTitle" class="card-title h4">Get more libraries</h2>
                    <p class="card-text">NuGet is a package manager for .NET that makes it easy to add, remove, and update libraries and tools in .NET projects.</p>
                    <a class="btn btn-outline-primary" href="https://www.nuget.org/">Learn more &raquo;</a>
                </div>
            </div>
        </section>
        <section class="col-md-4" aria-labelledby="hostingTitle">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 id="hostingTitle" class="card-title h4">Cloud Hosting</h2>
                    <p class="card-text">You can deploy your ASP.NET Core apps to Azure or other cloud providers with minimal configuration and maximum security.</p>
                    <a class="btn btn-outline-primary" href="https://azure.microsoft.com/services/app-service/">Learn more &raquo;</a>
                </div>
            </div>
        </section>
    </div>
</main>