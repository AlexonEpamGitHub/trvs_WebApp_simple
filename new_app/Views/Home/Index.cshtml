@{
    ViewData["Title"] = "Home Page";
}

<main>
    <section class="row" aria-labelledby="aspnetTitle">
        <h1 id="title">ASP.NET Core</h1>
        <p class="lead">ASP.NET Core is a cross-platform, high-performance, open-source framework for building modern, cloud-enabled, Internet-connected applications.</p>
        <p><a href="https://learn.microsoft.com/aspnet/core" class="btn btn-primary btn-md">Learn more &raquo;</a></p>
    </section>

    <div class="row">
        <section class="col-md-4" aria-labelledby="gettingStartedTitle">
            <h2 id="gettingStartedTitle">Getting started</h2>
            <p>
                ASP.NET Core MVC gives you a powerful, patterns-based way to build dynamic websites that
                enables a clean separation of concerns and gives you full control over markup
                for enjoyable, agile development.
            </p>
            <p><a class="btn btn-outline-dark" href="https://learn.microsoft.com/aspnet/core/tutorials/first-mvc-app/start-mvc">Learn more &raquo;</a></p>
        </section>
        <section class="col-md-4" aria-labelledby="librariesTitle">
            <h2 id="librariesTitle">Get more libraries</h2>
            <p>NuGet is a free extension that makes it easy to add, remove, and update libraries and tools in .NET projects.</p>
            <p><a class="btn btn-outline-dark" href="https://learn.microsoft.com/nuget/">Learn more &raquo;</a></p>
        </section>
        <section class="col-md-4" aria-labelledby="hostingTitle">
            <h2 id="hostingTitle">Web Hosting</h2>
            <p>You can easily deploy your ASP.NET Core applications to Azure or other cloud providers.</p>
            <p><a class="btn btn-outline-dark" href="https://learn.microsoft.com/aspnet/core/host-and-deploy/">Learn more &raquo;</a></p>
        </section>
    </div>
</main>