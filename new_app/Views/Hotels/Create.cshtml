@model new_app.Models.Hotel

@{
    ViewData["Title"] = "Create Hotel";
}

<h1>@ViewData["Title"]</h1>

<h4>Create a new hotel</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" placeholder="Hotel name" />
                <label asp-for="Name"></label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-3">
                <select asp-for="CountryId" class="form-select" asp-items="ViewBag.CountryId"></select>
                <label asp-for="CountryId"></label>
                <span asp-validation-for="CountryId" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-3">
                <input asp-for="City" class="form-control" placeholder="City" />
                <label asp-for="City"></label>
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-3">
                <input asp-for="Stars" class="form-control" placeholder="Stars" />
                <label asp-for="Stars"></label>
                <span asp-validation-for="Stars" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-3">
                <input asp-for="PricePerNight" class="form-control" placeholder="Price per night" />
                <label asp-for="PricePerNight"></label>
                <span asp-validation-for="PricePerNight" class="text-danger"></span>
            </div>
            
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsAllInclusive" />
                <label class="form-check-label" asp-for="IsAllInclusive"></label>
            </div>
            
            <div class="d-flex gap-2 mb-3">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}