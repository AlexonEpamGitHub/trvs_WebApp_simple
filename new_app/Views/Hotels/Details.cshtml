@model YourNamespace.Models.Hotel

@{
    ViewData["Title"] = "Hotel Details";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Country</dt>
    <dd class="col-sm-10">@Model.Country.Name</dd>

    <dt class="col-sm-2">City</dt>
    <dd class="col-sm-10">@Model.City</dd>

    <dt class="col-sm-2">Stars</dt>
    <dd class="col-sm-10">@Model.Stars</dd>

    <dt class="col-sm-2">Price per Night</dt>
    <dd class="col-sm-10">@Model.PricePerNight</dd>

    <dt class="col-sm-2">All Inclusive</dt>
    <dd class="col-sm-10">@(Model.IsAllInclusive ? "Yes" : "No")</dd>
</dl>

<a asp-action="Index" class="btn btn-primary">Back to List</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>