@model new_app.Models.Hotel

@{
    ViewData["Title"] = "Hotel Details";
}

<h2>Hotel Details</h2>

<div>
    <h4>Hotel Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Country.Name)
        </dt>
        <dd class="col-sm-9">
            @Model.Country?.Name
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.City)
        </dt>
        <dd class="col-sm-9">
            @Model.City
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Stars)
        </dt>
        <dd class="col-sm-9">
            @Model.Stars
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.PricePerNight)
        </dt>
        <dd class="col-sm-9">
            @Model.PricePerNight.ToString("C")
        </dd>
        
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.IsAllInclusive)
        </dt>
        <dd class="col-sm-9">
            @(Model.IsAllInclusive ? "Yes" : "No")
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>