@model IEnumerable<YourNamespace.Models.Country>

@{
    ViewData["Title"] = "Countries";
}

<h2>Countries</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Add New Country</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var country in Model)
        {
            <tr>
                <td>@country.Name</td>
                <td>@country.Code</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@country.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@country.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@country.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>