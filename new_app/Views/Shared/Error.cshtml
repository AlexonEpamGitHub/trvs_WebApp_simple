@model string

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-mQ93mV2iKfdomZ6hwTG8fR92bWaXrBhxj1D65XKjz1kiTApel2wSGU5KyjKJg6gD" crossorigin="anonymous" />
</head>
<body>
    <div class="container mt-5">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">An error occurred!</h4>
            <p>@Model</p>
            <hr />
            <p class="mb-0">
                <a href="/" class="btn btn-primary">Go back to Home</a>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeo6lUYKhRhj5YA1Cw7HtvIA9YYJ5CJM1sz9zen2HBAY7EkE" crossorigin="anonymous"></script>
</body>
</html>