@model IEnumerable<Hotel>

@{
    ViewData["Title"] = "Hotel List";
}

<h1>Hotel List</h1>

<p>
    <a class="btn btn-primary" asp-controller="Hotel" asp-action="Create">Create Hotel</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>City</th>
            <th>Country</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td>@hotel.Name</td>
                <td>@hotel.Address</td>
                <td>@hotel.City</td>
                <td>@hotel.Country.Name</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-controller="Hotel" asp-action="Details" asp-route-id="@hotel.Id">Details</a>
                    <a class="btn btn-warning btn-sm" asp-controller="Hotel" asp-action="Edit" asp-route-id="@hotel.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-controller="Hotel" asp-action="Delete" asp-route-id="@hotel.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>