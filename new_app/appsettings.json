{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=WebApplication_Core;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    }
  },
  "ApplicationSettings": {
    "JwtSettings": {
      "Secret": "YourSecretKeyHere_MakeThisLongAndComplex_AtLeast32Characters",
      "Issuer": "YourAppName",
      "Audience": "YourAppUsers",
      "ExpiryInMinutes": 60
    },
    "FeatureFlags": {
      "EnableNewFeatures": false
    },
    "EmailSettings": {
      "SmtpServer": "smtp.example.com",
      "SmtpPort": 587,
      "SenderEmail": "noreply@example.com"
    }
  }
}