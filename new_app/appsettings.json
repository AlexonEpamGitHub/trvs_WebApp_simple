{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HotelReservationSystem;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "MvcOptions": {
    "ClientValidationEnabled": true,
    "UnobtrusiveJavaScriptEnabled": true,
    "SuppressImplicitRequiredAttributeForNonNullableReferenceTypes": false
  },
  "JsonOptions": {
    "PropertyNamingPolicy": "CamelCase",
    "WriteIndented": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001",
        "Protocols": "Http1AndHttp2AndHttp3"
      }
    },
    "Http3": {
      "EnableAltSvc": true
    }
  },
  "ApplicationInsights": {
    "ConnectionString": null,
    "EnableAdaptiveSampling": true,
    "EnablePerformanceCounterCollectionModule": true
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5000",
          "https://localhost:5001"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}
