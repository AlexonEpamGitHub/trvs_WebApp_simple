@{
    ViewData["Title"] = "Home Page";
}

<div class="jumbotron">
    <h1>Hotel Reservation System</h1>
    <p class="lead">Welcome to the Hotel Reservation System. This application allows you to manage hotels and countries.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Hotels</h2>
        <p>Manage your hotel inventory.</p>
        <p><a class="btn btn-primary" asp-controller="Hotels" asp-action="Index">View Hotels &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Countries</h2>
        <p>Manage available countries.</p>
        <p><a class="btn btn-primary" asp-controller="Countries" asp-action="Index">View Countries &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Contact Us</h2>
        <p>Get in touch with our support team.</p>
        <p><a class="btn btn-primary" asp-controller="Home" asp-action="Contact">Contact &raquo;</a></p>
    </div>
</div>