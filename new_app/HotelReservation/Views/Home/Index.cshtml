@{
    ViewData["Title"] = "Home";
}

<div class="jumbotron">
    <h1>Hotel Reservation System</h1>
    <p class="lead">Welcome to the Hotel Reservation System. This application allows you to manage hotels and reservations.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Hotels</h2>
        <p>Manage your hotel inventory, including locations, prices, and amenities.</p>
        <p><a class="btn btn-primary" asp-controller="Hotels" asp-action="Index">View Hotels &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Countries</h2>
        <p>Manage the list of countries where your hotels are located.</p>
        <p><a class="btn btn-primary" asp-controller="Countries" asp-action="Index">View Countries &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Learn More</h2>
        <p>Learn more about our hotel reservation services and features.</p>
        <p><a class="btn btn-primary" asp-controller="Home" asp-action="About">About &raquo;</a></p>
    </div>
</div>