@model HotelReservationSystem.Models.Hotel

@{
    ViewData["Title"] = "Create";
}

<h2>Create</h2>

<form asp-action="Create">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>Hotel</h4>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3 row">
                        <label asp-for="Name" class="control-label col-md-2"></label>
                        <div class="col-md-10">
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="CountryId" class="control-label col-md-2">Country</label>
                        <div class="col-md-10">
                            <select asp-for="CountryId" class="form-select" asp-items="ViewBag.CountryId"></select>
                            <span asp-validation-for="CountryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="City" class="control-label col-md-2"></label>
                        <div class="col-md-10">
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Stars" class="control-label col-md-2"></label>
                        <div class="col-md-10">
                            <input asp-for="Stars" class="form-control" />
                            <span asp-validation-for="Stars" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="PricePerNight" class="control-label col-md-2"></label>
                        <div class="col-md-10">
                            <input asp-for="PricePerNight" class="form-control" />
                            <span asp-validation-for="PricePerNight" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="IsAllInclusive" class="control-label col-md-2"></label>
                        <div class="col-md-10">
                            <div class="form-check">
                                <input asp-for="IsAllInclusive" class="form-check-input" />
                                <span asp-validation-for="IsAllInclusive" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <div class="col-md-10 offset-md-2">
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
