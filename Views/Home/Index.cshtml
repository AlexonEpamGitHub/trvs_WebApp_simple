@{
    ViewData["Title"] = "Home Page";
}

<div class="bg-light p-5 rounded-3 mb-4">
    <div class="container-fluid">
        <h1 class="display-4">Hotel Reservation System</h1>
        <p class="lead">Welcome to our hotel reservation system. Book your stay today!</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Hotels</h2>
                <p class="card-text">Browse our selection of hotels.</p>
            </div>
            <div class="card-footer">
                <a class="btn btn-primary" asp-controller="Hotels" asp-action="Index">View Hotels</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Countries</h2>
                <p class="card-text">Browse hotels by country.</p>
            </div>
            <div class="card-footer">
                <a class="btn btn-primary" asp-controller="Countries" asp-action="Index">View Countries</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Contact</h2>
                <p class="card-text">Contact us for assistance.</p>
            </div>
            <div class="card-footer">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Contact">Contact Us</a>
            </div>
        </div>
    </div>
</div>