@model HotelReservationSystem.Models.Country

@{
    ViewData["Title"] = "Delete Country";
}

<div class="container mt-4">
    <h1>Delete Country</h1>
    
    <div class="alert alert-warning">
        <h4>Are you sure you want to delete this country?</h4>
        <p>This action cannot be undone.</p>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5>Country Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class="col-sm-9">@Model.Name</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </form>
</div>